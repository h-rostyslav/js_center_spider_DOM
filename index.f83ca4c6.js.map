function centerSpider() {
    var wall = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    var wallWidth = wall.offsetWidth - 20;
    var wallHeight = wall.offsetWidth - 20;
    var centerX = (wallWidth - spiderWidth) / 2;
    var centerY = (wallHeight - spiderHeight) / 2;
